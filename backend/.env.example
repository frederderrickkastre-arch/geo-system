PORT=3001
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=geo_system

REDIS_HOST=localhost
REDIS_PORT=6379

# AI 大模型配置
# ------------------------------------------------------------------
# 场景 1：直接用官方厂商
#   AI_PROVIDER = deepseek | qianwen | wenxin | openai
#   AI_API_KEY  = 厂商控制台申请的 Key
#   AI_BASE_URL = 留空（使用厂商默认地址）
#   AI_MODEL    = 留空（使用默认模型，如 deepseek-chat）
#
# 场景 2：用 API 中转站（OpenAI 兼容协议）
#   AI_PROVIDER = openai
#   AI_API_KEY  = 中转站控制台申请的 Key（通常也是 sk- 开头）
#   AI_BASE_URL = 中转站给的 base URL，以下任意一种格式都支持：
#                   https://relay.example.com
#                   https://relay.example.com/v1
#                   https://relay.example.com/v1/chat/completions
#   AI_MODEL    = 中转站支持的模型名，如 gpt-4o-mini / deepseek-chat /
#                 claude-sonnet-4-6 / gemini-2.0-flash 等
#
# 配好后到管理员面板 → "AI 服务连通性" → 点"立即自检"验证。
# ------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_BASE_URL=
AI_MODEL=deepseek-chat

# File upload directory (local storage, default: ./uploads)
UPLOAD_DIR=uploads
