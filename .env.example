# docker-compose 启动时使用的环境变量示例
# 复制为 .env 并填入真实值，.env 不会被提交到仓库

# JWT 签名密钥 —— 生产必改，建议 32+ 位随机字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 数据库密码（同时用于 mysql root 与后端连接）
DB_PASSWORD=geo_db_password

# AI 服务商配置
# 官方厂商：AI_BASE_URL 留空即可
# API 中转站：把中转站给的 base URL 填进 AI_BASE_URL（端点会自动补全）
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=deepseek-chat
