# Copy this file to .env and fill in real values before running docker-compose up.
# .env is gitignored — never commit real secrets.

NODE_ENV=production

# Public ports
FRONTEND_PORT=80
BACKEND_PORT=3001

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MySQL
DB_USER=root
DB_PASSWORD=
DB_NAME=geo_system
DB_POOL_SIZE=10

# CORS — comma-separated origin list, or a single origin. Use * only for local dev.
CORS_ORIGIN=*

# AI provider
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
